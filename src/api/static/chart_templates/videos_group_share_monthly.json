{
  "id": 6,
  "title": "videos pct share of total per group per month",
  "chartOption": {
    "title": {
      "text": "Monthly Video Share by Talent Group"
    },
    "tooltip": {
      "trigger": "item",
      "axisPointer": {
        "type": "shadow"
      },
      "formatter": "{b}<br/>{a}: {c} <br/> vids: {videos_num}"
    },
    "legend": {
      "top": 30,
      "type": "scroll"
    },
    "grid": {
      "top": "70",
      "left": "40",
      "right": "20",
      "bottom": "50",
      "containLabel": true
    },
    "xAxis": [
