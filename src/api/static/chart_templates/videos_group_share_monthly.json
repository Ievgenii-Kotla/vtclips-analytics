    "yAxis": [
      {
        "type": "value"
      }
    ],
    "series": [
      {
        "name": "Direct",
        "type": "bar",
        "stack": "total",
        "barWidth": "80%",
        "label": {
          "show": true
        },
        "emphasis": {
          "focus": "series"
