# 1. Version control
.git/
.gitignore

# 2. Python cache and build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage

# 3. IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# 4. Build outputs and distribution
build/
dist/
out/

# 5. Test files and directories
test/
tests/
*.test

# 6. Logs and debug files
logs/
*.log

# 7. Environment and secrets
.env*
*.env
*.pem
*.key
*.crt

# 8. Project-specific patterns
Dockerfile*
docker-compose*
README*
*.md
docs/

# 9. Temporary and local development files
tmp/
temp/
*.tmp
.local/
local/

# 10. Node.js (precautionary, not detected but for completeness)
node_modules/
npm-debug.log
yarn-debug.log

# 11. Go (precautionary)
/vendor/
.go-cache/

# 12. Java (precautionary)
target/
*.class
.gradle/

# 13. Miscellaneous
*.bat

# 14. Exclude virtual environments
.venv/

# 15. Alembic cache
alembic/versions/__pycache__/

# 16. State and data backups (if not needed in build)
data/backups/
data/initial_data/
data/seed_data/
state/

# 17. Script logs
scripts/logs/

# 18. Frontend placeholder (if not needed)
src/frontend/

# 19. Exclude empty directories (Docker ignores them by default, but for clarity)
**/.gitkeep

# End of .dockerignore
