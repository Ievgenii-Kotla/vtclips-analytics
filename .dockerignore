# 1. Version control
.git/
.gitignore

# 2. Python cache and build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage

# 3. Virtual environments
.venv/
venv/
ENV/

# 4. IDE/editor files
.idea/
.vscode/
*.swp
*.swo

# 5. Build outputs and distribution
build/
dist/
out/

# 6. Test and debug artifacts
tests/
test/
*.log
logs/

# 7. Environment and secrets
.env*
*.env
*.pem
*.key
*.crt

# 8. Project-specific patterns
alembic/versions/__pycache__/
src/__pycache__/
src/vtc/__pycache__/
scripts/logs/
tests/__pycache__/
tests/fixtures/__pycache__/

# 9. Documentation and markdown
*.md
README*

# 10. Temporary and local files
tmp/
temp/
*.tmp
.local/
local/

# 11. Miscellaneous
*.bak
*.old
*.orig

# 12. Ignore Docker-related files (if not needed in build context)
Dockerfile*
docker-compose*

# 13. Ignore other VCS (precautionary)
.svn/
.hg/

# End of .dockerignore
