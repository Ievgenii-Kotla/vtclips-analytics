# syntax=docker/dockerfile:1

FROM node:20 AS build
WORKDIR /app
COPY package.json tailwind.config.js ./
RUN npm install
RUN ls -l /app/node_modules/daisyui
COPY src/api ./src/api
RUN npx tailwindcss -i ./src/api/styles.css -o ./src/api/static/css/style.css



FROM python:3.10.6 AS base

WORKDIR /app

# Builder stage: install dependencies into a venv
FROM base AS builder

# Install system dependencies required for psycopg2 and other packages
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        libpq-dev \
        libpq5 \
        libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements.txt only (for better cache usage)
COPY --link requirements.txt ./

# Create venv and install dependencies using pip cache
RUN python -m venv .venv \
    && .venv/bin/pip install -r requirements.txt

# Copy the rest of the application code (excluding .git, .venv, etc. via .dockerignore)
COPY --link alembic alembic
COPY --link alembic.ini alembic.ini
COPY --link src src
COPY --link scripts scripts

# Final stage: minimal runtime image
FROM base AS final

# Create a non-root user
RUN useradd -m apiuser

WORKDIR /app

# Copy venv from builder
COPY --from=builder /app/.venv /app/.venv

# Copy application code from builder
COPY --from=builder /app/alembic alembic
COPY --from=builder /app/alembic.ini alembic.ini
COPY --from=builder /app/src src
COPY --from=builder /app/scripts scripts

# Copy from build
COPY --from=build /app/src/api src/api

# Set environment variables
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

# Switch to non-root user
USER apiuser

# Expose the port FastAPI will run on (default 8000)
EXPOSE 8000

# Default command to run the FastAPI app
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
